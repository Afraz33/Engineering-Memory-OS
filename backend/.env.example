# Which chat backend to use: gemini | anthropic | openai
LLM_PROVIDER=gemini

# Optional system prompt applied to every chat request. Server-owned on
# purpose: clients only send messages, so they can't override the persona.
# SYSTEM_PROMPT=You are the Engineering Memory OS assistant.

# Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Only needed when LLM_PROVIDER=anthropic  (uv sync --extra anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Only needed when LLM_PROVIDER=openai  (uv sync --extra openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local docker-compose default shown; point at CockroachDB Cloud for a hosted
# cluster. Contains a password — keep it here, never in db/session.py.
DATABASE_URL=

# --- Google sign-in -------------------------------------------------------
# Google Cloud Console → Credentials → OAuth client ID → Web application.
# Add http://localhost:5173 under "Authorized JavaScript origins".
# No client secret: the ID-token flow does not use one.
# This is NOT the same value as GOOGLE_API_KEY above.
GOOGLE_OAUTH_CLIENT_ID=

# Signs our own session JWT. Rotating it logs everyone out.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_DAYS=30

# Set to true in production so the cookie is only sent over HTTPS.
SESSION_COOKIE_SECURE=
