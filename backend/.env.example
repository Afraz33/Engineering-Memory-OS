# Which chat backend to use: gemini | anthropic | openai | ollama
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Optional system prompt applied to every chat request. Server-owned on
# purpose: clients only send messages, so they can't override the persona.
# SYSTEM_PROMPT=You are the Engineering Memory OS assistant.

# Local Ollama settings
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:0.5b
# OLLAMA_EMBEDDING_MODEL=granite-embedding:30m

# Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Only needed when LLM_PROVIDER=anthropic  (uv sync --extra anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Only needed when LLM_PROVIDER=openai  (uv sync --extra openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
