# LLM provider: openrouter | gemini
LLM_PROVIDER=openrouter

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite-preview-06-17:free

# Google AI Studio (only if LLM_PROVIDER=gemini)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# CockroachDB — overridden by docker-compose in containers
DATABASE_URL=cockroachdb+psycopg://root@localhost:26257/engineering_memory?sslmode=disable

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
